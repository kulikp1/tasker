# Public, non-secret values only - these end up in the client JS bundle.
# API base URL - leave as /api for both dev (proxied by Vite, see vite.config.ts) and prod (same-origin on Vercel).
VITE_API_BASE_URL=/api

# Pusher Channels public app key + cluster (from Pusher dashboard -> App Keys). The "key" is public by design,
# safe to ship to the client - only PUSHER_SECRET (backend-only) must never appear here.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=

# Google OAuth Client ID (same value as backend GOOGLE_CLIENT_ID) - public by design, used by
# Google Identity Services in the browser to render the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
