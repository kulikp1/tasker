# Server
PORT=4000
NODE_ENV=development
# Origin of the frontend dev server, used for CORS when frontend and backend run on different ports locally.
# In production (single Vercel deployment, same origin) this can be left blank.
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas (Free M0 cluster) - get from Atlas dashboard -> Database -> Connect -> Drivers
MONGODB_URI=

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie domain - leave blank for same-host deployments (recommended setup)
COOKIE_DOMAIN=

# Cloudinary (Free tier) - from Cloudinary dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pusher Channels (Free tier) - from Pusher dashboard -> App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# AES-256 key used to encrypt Monobank personal tokens at rest, 32 bytes hex.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Google OAuth Client ID (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application"). Same value goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Email to bootstrap as the first admin when running `npm run seed` on an empty database (optional).
ADMIN_SEED_EMAIL=
